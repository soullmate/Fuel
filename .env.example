# USDA FoodData Central API Key
# Get yours free at: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_api_key_here

# Web server port (optional, default 3456)
PORT=3456

# Bind address (default 127.0.0.1 = localhost only)
# Set to 0.0.0.0 for remote access
HOST=127.0.0.1

# Secret URL prefix for dashboard access
# Recommended format: fuel-{random-hex} (e.g., fuel-7f3b2c1d4e5a)
# Generate with: echo "fuel-$(openssl rand -hex 6)"
ACCESS_TOKEN=change_me_to_random_hex

# Timezone for daily date calculations (IANA timezone name)
USER_TIMEZONE=UTC
